    function Bypass.disableAntiCheatScripts()
        try(function()
            local function scan(container)
                for _, s in ipairs(container:GetDescendants()) do
                    if s:IsA("LocalScript") then
                        local n = s.Name:lower()
                        if n:find("anti") or n:find("ac_") or n:find("detect")
                        or n:find("shield") or n:find("guard") or n:find("sentry")
                        or n:find("brainrot") or n:find("steal") then
                            s.Disabled = true
                            Bypass.ScriptsDisabled = Bypass.ScriptsDisabled + 1
                        end
                    end
                end
            end
            scan(PlayerGui)
            scan(game)
        end)
    end

    -- 7. УДАЛЕНИЕ REMOTE-ШПИОНОВ
    function Bypass.destroySuspiciousRemotes()
        try(function()
            for _, o in ipairs(game:GetDescendants()) do
                if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
                    local n = o.Name:lower()
                    if n:find("kick") or n:find("ban") or n:find("report") or n:find("log")
                    or n:find("cheat") or n:find("anticheat") or n:find("flag")
                    or n:find("brainrot") or n:find("steal") or n:find("split") then
                        o:Destroy()
                        Bypass.RemotesDestroyed = Bypass.RemotesDestroyed + 1
                    end
                end
            end
        end)

        if hasGetGC then
            try(function()
                for _, obj in pairs(getgc(true)) do
                    if typeof(obj) == "Instance" and (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then
                        local okN, n = pcall(function() return obj.Name:lower() end)
                        if okN and n then
                            if n:find("kick") or n:find("ban") or n:find("report")
                            or n:find("cheat") or n:find("anticheat") or n:find("flag") then
                                obj:Destroy()
                                Bypass.GCRemotesDestroyed = Bypass.GCRemotesDestroyed + 1
                            end
                        end
                    end
                end
            end)
        end
    end

    -- 8. SPEED BYPASS
    function Bypass.setSpeed(enabled)
        Bypass.SpeedEnabled = enabled
        if enabled then
            tryTask(function()
                while task.wait(0.05) do
                    try(function()
                        if not Bypass.SpeedEnabled then task.wait(0.3) return end
                        local char = LP.Character
                        if not char then return end
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if not hum or not hrp then return end

                        local curSpeed = hrp.AssemblyLinearVelocity.Magnitude
                        table.insert(Bypass.SpeedHistory, curSpeed)
                        if #Bypass.SpeedHistory > 20 then table.remove(Bypass.SpeedHistory, 1) end
                        local sum = 0
                        for _, s in ipairs(Bypass.SpeedHistory) do sum = sum + s end
                        Bypass.AvgSpeed = sum / #Bypass.SpeedHistory

                        if Bypass.AvgSpeed > 30 then
                            Bypass.SuspicionLevel = Bypass.SuspicionLevel + 1
                        else
                            Bypass.SuspicionLevel = math.max(0, Bypass.SuspicionLevel - 1)
                        end

                        if Bypass.SuspicionLevel > 10 then
                            hum.WalkSpeed = 16
                            hrp.AssemblyLinearVelocity = Vector3.new(
                                hrp.AssemblyLinearVelocity.X * 0.7,
                                hrp.AssemblyLinearVelocity.Y,
                                hrp.AssemblyLinearVelocity.Z * 0.7
                            )
                        end

                        if hum.WalkSpeed < 24 then hum.WalkSpeed = 24 end
                    end)
                end
            end)
        end
    end

    -- 9. JUMP BYPASS
    function Bypass.setJump(enabled)
        Bypass.JumpEnabled = enabled
        if enabled then
            tryTask(function()
                while task.wait(0.02) do
                    try(function()
                        if not Bypass.JumpEnabled then task.wait(0.2) return end
                        local char = LP.Character
                        if not char then return end
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if not hum or not hrp then return end

                        if hum.JumpPower < 50 then hum.JumpPower = 50 end
                        if hum.UseJumpPower == false then hum.UseJumpPower = true end

                        local ry = hrp.Position.Y
                        local v = hrp.AssemblyLinearVelocity

                        if Bypass.LastRealY > 5 and ry < (Bypass.LastRealY - 15) and v.Y < -100 then
                            hrp.CFrame = CFrame.new(hrp.Position.X, Bypass.LastRealY, hrp.Position.Z)
                            hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
                            Bypass.ResetAttempts = Bypass.ResetAttempts + 1
                        end

                        if ry > Bypass.FakeY then Bypass.FakeY = math.min(ry, 30)
                        elseif ry < 3 then Bypass.FakeY = ry end
                        Bypass.LastRealY = ry
                    end)
                end
            end)

            tryTask(function()
                while task.wait(0.1) do
                    try(function()
                        if not Bypass.JumpEnabled then task.wait(0.3) return end
                        if Bypass.ResetAttempts > 5 then
                            Bypass.ResetAttempts = 0
                            local char = LP.Character
                            if char then
                                local hrp = char:FindFirstChild("HumanoidRootPart")
                                if hrp then Bypass.FakeY = hrp.Position.Y end
                            end
                        end
                    end)
                end
            end)
        end
    end

    function Bypass.simulateJump()
        try(function()
            local vu = game:GetService("VirtualUser")
            if vu then
                vu:Button1Down(Vector2.new(0, 0))
                vu:Button1Up(Vector2.new(0, 0))
            end
        end)
    end

    function Bypass.enable()
        if Bypass.Enabled then return end
        Bypass.Enabled = true
        try(function() Bypass.disableConns() end)
        try(function() Bypass.blockIdled() end)
        try(function() Bypass.disableAntiCheatScripts() end)
        try(function() Bypass.destroySuspiciousRemotes() end)
    end
    try(function() Bypass.enable() end)
end)

-- ==================== SAVE ====================
local SaveSystem = {}
try(function()
    SaveSystem.FILE = "NegorHub_Config.json"
    SaveSystem.Enabled = type(writefile) == "function" and type(readfile) == "function"
    SaveSystem.Data = {}
    local function ser(t)
        local ty = type(t)
        if ty == "string" then return string.format("%q", t)
        elseif ty == "number" or ty == "boolean" then return tostring(t)
        elseif ty == "table" then
            local p = {}
            for k, v in pairs(t) do
                local key = (type(k) == "string" and k:match("^[%a_][%w_]*$")) and k or ("[" .. ser(k) .. "]")
                table.insert(p, key .. "=" .. ser(v))
            end
            return "{" .. table.concat(p, ",") .. "}"
        end
        return "nil"
    end
    local function des(str)
        local f = loadstring("return " .. str)
        if f then
            local ok, r = pcall(f)
            if ok then return r end
        end
        return nil
    end
    function SaveSystem.save(k, v)
        if not SaveSystem.Enabled then return end
        SaveSystem.Data[k] = v
        try(function() writefile(SaveSystem.FILE, ser(SaveSystem.Data)) end)
    end
    function SaveSystem.load()
        if not SaveSystem.Enabled then return {} end
        local ok, c = pcall(function() return readfile(SaveSystem.FILE) end)
        if ok and c and #c > 0 then
            local d = des(c)
            if type(d) == "table" then SaveSystem.Data = d return d end
        end
        return {}
    end
    try(function() SaveSystem.load() end)
end)

