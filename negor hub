    -- 4. DISABLE CONNS
    function Bypass.disableConns()
        if not hasGetConns then return end
        local kw = {
            "anticheat","detect","validate","checkspeed","speedcheck","monitor",
            "suspicious","checkjump","checkpos","position_check","height_check",
            "air_check","y_check","fly_check","track","scan","audit","watch",
            "log","report","flag","kick","ban","punish","sentry","guard",
            "checker","check_","_check","ac_","_ac",
            "brainrot","steal","split","duel","money","cash","roll","luck"
        }
        local function scan(s, e)
            try(function()
                local ev = s[e]
                if not ev then return end
                for _, c in ipairs(getconnections(ev)) do
                    try(function()
                        local f = c.Function
                        if not f then return end
                        if hasIscClosure and iscclosure(f) then return end
                        local okInfo, info = pcall(function()
                            return debug and debug.info and debug.info(f, "s")
                        end)
                        if okInfo and type(info) == "string" then
                            local lower = info:lower()
                            for _, k in ipairs(kw) do
                                if lower:find(k) then
                                    if c.Disconnect then c:Disconnect() end
                                    break
                                end
                            end
                        end
                    end)
                end
            end)
        end
        scan(RunService, "Heartbeat")
        scan(RunService, "RenderStepped")
        scan(RunService, "Stepped")
        scan(RunService, "PreSimulation")
        scan(RunService, "PostSimulation")
        scan(RunService, "PreRender")
    end

    -- 5. БЛОКИРОВКА IDLED
    function Bypass.blockIdled()
        if not hasGetConns then return end
        try(function()
            for _, c in ipairs(getconnections(LP.Idled)) do
                try(function()
                    if c.Disable then c:Disable() end
                    Bypass.IdleBlocked = Bypass.IdleBlocked + 1
