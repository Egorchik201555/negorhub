local AnimTracks = {}
local function applyAnim(key)
    try(function()
        local char = getChar()
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator")
        if not anim then
            anim = Instance.new("Animator")
            anim.Parent = hum
        end
        for _, t in ipairs(AnimTracks) do pcall(function() t:Stop() end) end
        AnimTracks = {}
        if key == "Default" then
            Config.Animation.Current = "Default"
            SaveSystem.save("Animation_Current", "Default")
            return
        end
        local p = AnimPresets[key]
        if not p then return end
        local list = {
            {p.Run}, {p.Walk}, {p.Jump}, p.Idle, {p.Fall}, {p.Swim}, {p.SwimIdle}, {p.Climb}
        }
        for _, ids in ipairs(list) do
            for _, id in ipairs(ids) do
                pcall(function()
                    local a = Instance.new("Animation")
                    a.AnimationId = "rbxassetid://" .. id
                    local t = anim:LoadAnimation(a)
                    t.Priority = Enum.AnimationPriority.Movement
                    t.Looped = true
                    t:Play()
                    table.insert(AnimTracks, t)
                end)
            end
        end
        Config.Animation.Current = key
        SaveSystem.save("Animation_Current", key)
    end)
end

