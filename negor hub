        try(function()
            if ASP then ASP.Visible = Config.AutoSteal.Enabled and MainFrame.Visible end
            if not Config.AutoSteal.Enabled then return end
            if Config.AutoSteal.Cooldown > 0 then
                Config.AutoSteal.Cooldown = Config.AutoSteal.Cooldown - 0.1
                return
            end
            if Config.AutoSteal.Progress > 0 and Config.AutoSteal.Progress < 100 then
                Config.AutoSteal.Progress = math.min(100, Config.AutoSteal.Progress + (100 / 15))
                local pct = math.floor(Config.AutoSteal.Progress)
                if ASF then ASF.Size = UDim2.new(Config.AutoSteal.Progress / 100, 0, 1, 0) end
                if ASTx then ASTx.Text = pct .. "%" end
                if ASS then ASS.Text = "Stealing " .. pct .. "%" end
                return
            end
            if Config.AutoSteal.Progress == 0 then
                local char = getChar() if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then return end
                local close, d = nil, math.huge
                for _, o in ipairs(Workspace:GetDescendants()) do
                    if o:IsA("ProximityPrompt") and o.Enabled then
                        local p = o.Parent
                        if p and p:IsA("BasePart") then
                            local dd = (p.Position - hrp.Position).Magnitude
                            if dd < d and dd < Config.AutoSteal.Range then d = dd close = o end
                        end
                    end
                end
                if close then
                    if ASS then ASS.Text = "Stealing 0%" end
                    Config.AutoSteal.Progress = 1
                    tryTask(function()
                        try(function()
                            local st = tick()
                            while tick() - st < 1.5 do
                                try(function() if close and close.Parent then close:InputHoldBegin() end end)
                                task.wait(0.05)
                            end
                            try(function() if close and close.Parent then close:InputHoldEnd() end end)
                            task.wait(0.05)
                            try(function() fireproximityprompt(close) end)
                            task.wait(0.1)
                            Config.AutoSteal.Progress = 0
                            Config.AutoSteal.Cooldown = 0.2
                            if ASF then ASF.Size = UDim2.new(0, 0, 1, 0) end
                            if ASTx then ASTx.Text = "0%" end
                            if ASS then ASS.Text = "Done!" end
                        end)
                    end)
                else
                    if ASS then ASS.Text = "No brainrot nearby" end
                    Config.AutoSteal.Progress = 0
                end
            end
        end)
    end
end)

