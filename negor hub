-- ГЛАВНАЯ ЗАЩИТА
local function try(fn, ...)
    local ok, result = pcall(fn, ...)
    if ok then return result end
    return nil
end

local function tryTask(fn)
    local ok = pcall(function()
        task.spawn(function()
            pcall(fn)
        end)
    end)
    return ok
end

