    -- 2. ПОДМЕНА СВОЙСТВ + БЛОК KICK/REMOTE/DESTROY
    if hasNewC and hasSetRO and hasGetRaw then
        try(function()
            local mt = getrawmetatable(game)
            if not mt then return end
            local oldIndex = mt.__index
            local oldNamecall = mt.__namecall
            setreadonly(mt, false)

            mt.__index = newcclosure(function(self, key)
                if Bypass.Enabled then
                    local ok, char = pcall(function() return LP.Character end)
                    if ok and char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local hrp = char:FindFirstChild("HumanoidRootPart")

                        if Bypass.SpeedEnabled and hum and self == hum then
                            if key == "WalkSpeed" then return 16 end
                            if key == "MoveDirection" then return Vector3.zero end
                        end

                        if Bypass.JumpEnabled and hum and self == hum then
                            if key == "JumpPower" then return 50 end
                            if key == "JumpHeight" then return 7.2 end
                            if key == "UseJumpPower" then return true end
                        end

                        if Bypass.JumpEnabled and hrp and self == hrp then
                            if key == "Position" then
