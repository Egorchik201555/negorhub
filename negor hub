local function EquipTool(char, name)
    try(function()
        if not char then return false end
        local cur = char:FindFirstChildOfClass("Tool")
        if cur and name and cur.Name:lower():find(name:lower()) then return true end
        local plr = Players:GetPlayerFromCharacter(char)
        local bp = plr and plr:FindFirstChildOfClass("Backpack")
        if bp then
            for _, i in ipairs(bp:GetChildren()) do
                if i:IsA("Tool") then
                    if name then
                        if i.Name:lower():find(name:lower()) then i.Parent = char return true end
                    else i.Parent = char return true end
                end
            end
        end
        return false
    end)
end

local function FindEnemy(dist)
    dist = dist or 35
    local char = getChar() if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then return nil end
    local close, d = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local tp = p.Character:FindFirstChild("HumanoidRootPart")
            local th = p.Character:FindFirstChildOfClass("Humanoid")
            if tp and th and th.Health > 0 then
                local dd = (tp.Position - hrp.Position).Magnitude
                if dd < d and dd < dist then d = dd close = p end
            end
        end
    end
    return close
end

local function InstAttack(char, enemy)
    try(function()
        if enemy and enemy.Character then
            local tp = enemy.Character:FindFirstChild("HumanoidRootPart")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if tp and hrp then hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(tp.Position.X, hrp.Position.Y, tp.Position.Z)) end
        end
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end)
end

local LHT, LMT, CC = 0, 0, 0
tryTask(function()
    while task.wait(0.01) do
        try(function()
            local char = getChar() if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid") if not hum then return end
            if Config.AntiRagdoll.Enabled or Config.BatCounter.Enabled or Config.MedusaCounter.Enabled then
                if hum.PlatformStand then hum.PlatformStand = false end
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Frozen, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
                if hum.WalkSpeed < 16 and not Config.Speed.Enabled then hum.WalkSpeed = 16 end
            end
            if CC > 0 then CC = CC - 0.01 return end
            if Config.BatCounter.Enabled then
                local st = hum:GetState()
                if (st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Ragdoll) and tick() - LHT > 0.5 then
                    LHT = tick() CC = 0.1
                    EquipTool(char, "bat")
                    if not char:FindFirstChildOfClass("Tool") then EquipTool(char, nil) end
                    InstAttack(char, FindEnemy(35))
                end
            end
            if Config.MedusaCounter.Enabled then
                if hum.WalkSpeed < 8 and tick() - LMT > 0.5 then
                    LMT = tick() CC = 0.1
                    EquipTool(char, "medusa")
                    if not char:FindFirstChildOfClass("Tool") then EquipTool(char, nil) end
                    InstAttack(char, FindEnemy(35))
                end
            end
        end)
    end
end)

